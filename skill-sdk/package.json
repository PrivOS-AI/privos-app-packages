{
  "name": "@privos_ai/skill-sdk",
  "version": "1.0.0",
  "description": "Skill-facing SDK for PrivOS: auto-detects sandbox vs non-sandbox mode, routes egress through proxy or directly.",
  "license": "MIT",
  "author": "PrivOS",
  "keywords": [
    "privos",
    "skill",
    "sdk",
    "mcp",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "lib/privos_skill.py",
    "lib/privos-skill.sh",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrivOS-AI/privos-app-packages.git",
    "directory": "skill-sdk"
  }
}
