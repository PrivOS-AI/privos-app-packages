{
  "name": "{{APP_ID}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts --dev-ui",
    "pair": "tsx scripts/pair.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "manifest:lint": "privos-app lint privos-app.json",
    "manifest:lint:publish": "privos-app lint privos-app.json --publish",
    "bundle:ui": "privos-app bundle-ui --out ui-bundle.tar",
    "publish:marketplace": "privos-app publish"
  },
  "dependencies": {
    "@privos_ai/app-server": "^0.12.3",
    "express": "^4.22.0"
  },
  "devDependencies": {
    "@privos_ai/app-react": "^0.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
