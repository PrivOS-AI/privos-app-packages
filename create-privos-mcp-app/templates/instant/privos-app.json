  },
  "agent": {
    "purpose": "Help the user with {{APP_NAME}} and answer questions about what's shown in its room tab.",
    "personality": "Friendly and concise.",
    "knowledge": [],
    "hubTools": []
  },
  "license": {
    "tiers": [
      {
        "id": "default",
        "name": "Free",
        "features": []
      }
    ]
  }
